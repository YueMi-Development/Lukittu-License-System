# Combined Environment File for Lukittu Web and Bot

# --- Web Application Configuration ---

# Web Port (Used internally in container, mapped to 3000)
PORT=3000

# Discord webhooks for notifications and status updates
DISCORD_WEBHOOK_URL=
INTERNAL_STATUS_WEBHOOK=

# Watermark service configuration
# WATERMARK_SERVICE_BASE_URL=http://localhost:8080

# Internal API security
INTERNAL_API_KEY=

# Redis configuration
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Virtual Host configuration for Reverse Proxy
VIRTUAL_HOST=license.example.com,www.license.example.com
VIRTUAL_PORT=3000

# Application URL
NEXT_PUBLIC_BASE_URL=https://license.example.com
BASE_URL=https://license.example.com

# Database configuration
DATABASE_URL=postgresql://user:password@localhost:5432/lukittu?schema=public
DATABASE_USERNAME=user
DATABASE_PASSWORD=password
DATABASE_NAME=lukittu

# Security keys and tokens (Shared between Web and Bot)
JWT_SECRET=
ENCRYPTION_KEY=
HMAC_KEY=

# SMTP configuration for email
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=license@example.com
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Lukittu - License System

# OAuth - Google authentication
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=https://license.example.com/api/auth/oauth/google

# Cloudflare Turnstile (CAPTCHA alternative)
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# OAuth - GitHub authentication
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_REDIRECT_URI=https://license.example.com/api/auth/oauth/github

# Sentry error tracking
SENTRY_AUTH_TOKEN=
SENTRY_SUPPRESS_TURBOPACK_WARNING=1
NEXT_PUBLIC_SENTRY_DSN=

# Public object storage
PUBLIC_OBJECT_STORAGE_ENDPOINT=
PUBLIC_OBJECT_STORAGE_BUCKET_NAME=
PUBLIC_OBJECT_STORAGE_ACCESS_KEY=
PUBLIC_OBJECT_STORAGE_SECRET_KEY=
PUBLIC_OBJECT_STORAGE_BASE_URL=
PUBLIC_OBJECT_STORAGE_REGION=ap-southeast-1

# Private object storage
PRIVATE_OBJECT_STORAGE_ENDPOINT=
PRIVATE_OBJECT_STORAGE_BUCKET_NAME=
PRIVATE_OBJECT_STORAGE_ACCESS_KEY=
PRIVATE_OBJECT_STORAGE_SECRET_KEY=
PRIVATE_OBJECT_STORAGE_REGION=ap-southeast-1

# Stripe payment processing
STRIPE_MONTHLY_PRICE_ID=monthly_price_id_here
STRIPE_YEARLY_PRICE_ID=yearly_price_id_here
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Discord OAuth2 configuration
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_DISCORD_REDIRECT_URI=https://license.example.com/api/auth/oauth/discord

# --- Bot Specific Configuration ---

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
